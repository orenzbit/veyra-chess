{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist/src"
  },
  "include": ["src/**/*.ts"]
}
