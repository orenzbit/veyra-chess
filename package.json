{
  "name": "veyra-chess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-rules.mjs && node scripts/build.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "check:bots": "node scripts/check-bots.mjs",
    "check:release": "npm run check && npm run check:rules && npm run check:mit-only && npm run check:bots && npm run check:access && npm run check:human && npm run check:puzzles && node scripts/check-release.mjs",
    "check:product": "node scripts/check-product.mjs",
    "check:access": "node scripts/check-access-approval.mjs",
    "check:mit-only": "node scripts/check-mit-only.mjs",
    "admin:hash": "node scripts/make-admin-hash.mjs",
    "build:openings": "node scripts/build-repertoire.mjs",
    "check:archive": "node scripts/check-archive.mjs",
    "check:account-sync": "node scripts/check-account-sync.mjs",
    "check:human": "node scripts/check-human-gate.mjs",
    "build:rules": "node scripts/build-rules.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:puzzles": "tsc -p tsconfig.json && node scripts/check-puzzle-app.mjs"
  },
  "dependencies": {
    "js-chess-engine": "^2.4.6",
    "altcha-lib": "^2.6.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0"
  }
}
